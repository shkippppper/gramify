# Copy to .env for local development.
DATABASE_URL=postgres://postgres@localhost:5432/gramify
# Public origin of the app (where the browser loads it). In dev that's the Vite server.
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32+chars
# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: restrict sign-in to Google Workspace domain(s). Leave empty to allow any Google account
# (boards are private to their creator until shared).
ALLOWED_GOOGLE_DOMAIN=
# Boards each person may own, trash included (0 = unlimited).
MAX_BOARDS_PER_USER=5
# Optional: shown on /privacy and /terms.
CONTACT_EMAIL=
# Enables passwordless "dev login" (name + email). Never enable in production.
DEV_LOGIN=true
PORT=3001
