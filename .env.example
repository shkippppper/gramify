# Copy to .env for local development.
DATABASE_URL=postgres://postgres@localhost:5432/tidepool
# Public origin of the app (where the browser loads it). In dev that's the Vite server.
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32+chars
# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only accounts from this Google Workspace domain can sign in (comma-separate several).
ALLOWED_GOOGLE_DOMAIN=example.com
# Enables passwordless "dev login" (name + email). Never enable in production.
DEV_LOGIN=true
PORT=3001
